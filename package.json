{
  "name": "angular-portfolio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "scripts": {
    "ng": "ng",
    "start": "npx ng serve",
    "dev": "npx ng serve --open",
    "build": "npx ng build",
    "build:prod": "npx ng build --configuration production",
    "watch": "npx ng build --watch --configuration development",
    "test": "npx ng test",
    "lint": "npx ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "typescript": "~5.9.2",
    "jsdom": "^27.1.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
